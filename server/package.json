{
  "name": "remotehire-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node src/index.ts",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
